# Railway Manager — variáveis de ambiente
# Copie para `.env` e ajuste. Durações em segundos.

# --- Acesso à aplicação (obrigatório: uma das duas) ---
# Hash argon2 da senha do administrador. Gere com:
#   railway-manager hash-password
RM_ADMIN_PASSWORD_HASH=
# Senha em texto claro, apenas para desenvolvimento local.
# Ignorada se RM_ADMIN_PASSWORD_HASH estiver definida.
RM_ADMIN_PASSWORD=

# --- Criptografia da credencial Railway (necessária para a integração) ---
# Sem ela o servidor sobe, mas a integração fica inativa.
# Chave de 32 bytes em base64. Gere com:
#   openssl rand -base64 32
# Perder esta chave torna o token cadastrado indecifrável (será preciso recadastrá-lo).
RM_MASTER_KEY=

# --- Servidor ---
# Endereço e porta HTTP.
# Sem RM_BIND_ADDR e com PORT definida (Railway), escuta em 0.0.0.0:$PORT.
RM_BIND_ADDR=0.0.0.0:8080
# Diretório com o build do frontend (frontend/dist).
RM_FRONTEND_DIR=./frontend/dist
# Nível de log (sintaxe de filtro do `tracing`).
RM_LOG=info

# --- Banco de dados ---
# No container, use o volume em /data: sqlite:///data/railway-manager.db
RM_DATABASE_URL=sqlite://railway-manager.db

# --- Sessão e login ---
# Duração da sessão do administrador.
RM_SESSION_TTL_SECS=43200
# Marca o cookie de sessão como `Secure` (ative quando servido via HTTPS).
RM_COOKIE_SECURE=false
# Tentativas de login falhas permitidas por janela antes de responder 429.
RM_LOGIN_MAX_ATTEMPTS=5
RM_LOGIN_WINDOW_SECS=300

# --- Integração com o Railway ---
# Endpoint da API pública (alterar só para testes).
RM_RAILWAY_API_URL=https://backboard.railway.com/graphql/v2
# Limite de requisições por segundo ao Railway (compartilhado por todas as chamadas).
RM_RAILWAY_RPS=5
# Timeouts de conexão e de requisição.
RM_RAILWAY_CONNECT_TIMEOUT_SECS=5
RM_RAILWAY_REQUEST_TIMEOUT_SECS=20
# Máximo de tentativas para consultas (mutations nunca são repetidas).
RM_RAILWAY_MAX_RETRIES=3
# Mecanismo de desligamento: `remove` (deploymentRemove) ou `stop` (deploymentStop).
RM_STOP_MECHANISM=remove

# --- Operações ---
# Instâncias processadas simultaneamente.
RM_MAX_CONCURRENCY=3
# Validade de um plano de operação antes da confirmação.
RM_PLAN_TTL_SECS=300
# Prazo para confirmar início/desligamento após a mutation.
RM_START_TIMEOUT_SECS=600
RM_STOP_TIMEOUT_SECS=180
# Intervalo inicial e máximo do polling de verificação.
RM_POLL_INTERVAL_SECS=5
RM_POLL_MAX_INTERVAL_SECS=15

# --- Estado observado ---
# Idade máxima de uma leitura para ser considerada `fresh`.
RM_STALE_AFTER_SECS=300

# --- Agendas ---
# Fuso horário padrão das agendas (nome IANA).
RM_SCHEDULE_TIMEZONE=America/Sao_Paulo
# Ao voltar de uma indisponibilidade, o evento perdido mais recente de cada agenda
# é executado se tiver ocorrido há até este tempo; os demais ficam como perdidos.
# 0 = nunca recupera.
RM_SCHEDULE_CATCHUP_SECS=1800
# Intervalo em que o agendador avalia as agendas.
RM_SCHEDULER_TICK_SECS=30
